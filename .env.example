# ============================================================
# Wisconsin State Patrol — Lakeville Roleplay
# Copy this file to .env and fill in your values.
# On Render, set these as Environment Variables instead.
# ============================================================

# Discord bot token (Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=

# Application ID (Developer Portal → General Information)
DISCORD_CLIENT_ID=

# OAuth2 client secret (Developer Portal → OAuth2) — required for the web dashboard login
DISCORD_CLIENT_SECRET=

# Comma-separated Discord user IDs with owner/superintendent override
OWNER_IDS=

# Primary guild (Discord server) ID. Role/channel IDs are set in Discord with /setupserver.
GUILD_ID=

# Public URL of this service (used for Discord OAuth redirects).
# Local: http://127.0.0.1:8080
# Render: https://<your-service>.onrender.com  (optional — RENDER_EXTERNAL_URL is used if this is empty)
DASHBOARD_BASE_URL=http://127.0.0.1:8080

# Secret used to sign web dashboard session cookies. Generate a long random string.
DASHBOARD_SECRET_KEY=change-me-to-a-long-random-value

# Bind address for the combined web service + bot process
HOST=0.0.0.0
PORT=8080

# SQLite path (PostgreSQL-ready schema; swap engine later without rewriting tables)
# Render persistent disk: /var/data/wsp.db
DATABASE_PATH=data/wsp.db

# Enable Message Content Intent in the Developer Portal (Bot → Privileged Gateway Intents)
# so ? prefix commands work in the server.

# Optional: timezone for quota weeks and LOA windows
TIMEZONE=America/Chicago

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# GitHub personal access token with Contents read/write on this repo.
# The bot stores shifts, setup, and personnel in data/wsp.db on the `data` branch
# (not main, so Render does not redeploy on every save).
GITHUB_TOKEN=

# Optional. Defaults to the git origin, e.g. hamburger445/WSP-bot
# GITHUB_REPO=

# Optional. Defaults: branch `data`, path `data/wsp.db`
# GITHUB_DB_BRANCH=data
# GITHUB_DB_PATH=data/wsp.db
